App(
    appid="continental_tg1c_lf",
    name="TPMSFlipper LF Lab",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="tg1c_lf_lab_app",
    requires=["gui", "storage"],
    stack_size=6 * 1024,
